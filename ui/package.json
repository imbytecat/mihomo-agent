{
  "name": "mihomo-agent-ufi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "check": "bun run --bun tsc --noEmit",
    "test": "bun run --bun vitest run --project node",
    "test:ui": "bun run build && bun run --bun vitest run --project browser",
    "browser:install": "bun run --bun playwright install --with-deps chromium",
    "test:watch": "bun run --bun vitest --project node"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@noble/hashes": "^2.4.0",
    "clsx": "^2.1.1",
    "ky": "^2.1.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.45.0",
    "p-queue": "^9.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "shell-quote": "^1.10.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
